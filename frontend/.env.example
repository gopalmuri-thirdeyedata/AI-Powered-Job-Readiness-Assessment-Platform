# ==============================================================================
# HIRINGAI FRONTEND PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.production (or set via CI/CD / hosting environment)

# Backend API Base URL (FastAPI)
VITE_API_URL=<PRODUCTION_API_BASE_URL>

# Clerk Authentication Publishable Key (Must start with pk_live_ in production)
VITE_CLERK_PUBLISHABLE_KEY=<PRODUCTION_CLERK_PUBLISHABLE_KEY>

# Vapi Voice Assistant Public Key
VITE_VAPI_PUBLIC_KEY=<PRODUCTION_VAPI_PUBLIC_KEY>
