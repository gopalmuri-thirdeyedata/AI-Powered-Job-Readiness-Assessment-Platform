# ==============================================================================
# HIRINGAI PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure with production credentials.
# NEVER commit the active .env file to version control.

# Application Environment
DEBUG=False
FRONTEND_URL=<PRODUCTION_FRONTEND_URL>
CORS_ORIGINS=<PRODUCTION_FRONTEND_URL>,<ADDITIONAL_PRODUCTION_DOMAINS>

# Database Configuration (MySQL)
# Option 1: Direct unified connection URI
DATABASE_URL=mysql+pymysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>

# Option 2: Individual database parameters (used if DATABASE_URL is not set)
DB_HOST=<PRODUCTION_DB_HOST>
DB_PORT=3306
DB_USER=<PRODUCTION_DB_USER>
DB_PASSWORD=<PRODUCTION_DB_PASSWORD>
DB_NAME=<PRODUCTION_DB_NAME>

# JWT Security
JWT_SECRET_KEY=<PRODUCTION_STRONG_RANDOM_SECRET_KEY_MIN_32_CHARS>

# Clerk Multi-Tenant Authentication & Platform Admin Settings
CLERK_SECRET_KEY=<PRODUCTION_CLERK_SECRET_KEY>
CLERK_PUBLISHABLE_KEY=<PRODUCTION_CLERK_PUBLISHABLE_KEY>
PLATFORM_ADMIN_CLERK_USER_ID=<PRODUCTION_PLATFORM_ADMIN_CLERK_USER_ID>
PLATFORM_ADMIN_EMAIL=admin@thirdeyedata.ai

# AI Provider Credentials
GEMINI_API_KEY=<PRODUCTION_GEMINI_API_KEY>
# Also used as the Vapi assistant LLM (provider "google"). Vapi runs that LLM itself, so a Google AI Studio
# credential must be added in the Vapi dashboard, and the model name must be one Vapi currently supports.
GEMINI_MODEL_NAME=gemini-2.5-flash
# Offline deterministic fixtures (no API key needed). Must be false in production.
GEMINI_MOCK_MODE=false

# Code execution sandbox (Judge0 CE compatible endpoint; hosting topology is a deferred decision)
JUDGE0_API_URL=https://ce.judge0.com/submissions

# Voice AI & Interview (Vapi)
VAPI_PRIVATE_KEY=<PRODUCTION_VAPI_PRIVATE_KEY>
VAPI_PUBLIC_KEY=<PRODUCTION_VAPI_PUBLIC_KEY>

# Code Execution Engine (Judge0 / Piston)
PISTON_API_URL=https://emkc.org/api/v2/piston/execute
PISTON_API_KEY=<PRODUCTION_PISTON_OR_JUDGE0_KEY>
PISTON_API_HOST=
PISTON_BEARER_TOKEN=

# SMTP Email Notification Service
EMAIL_HOST_USER=<PRODUCTION_SMTP_EMAIL>
EMAIL_HOST_PASSWORD=<PRODUCTION_SMTP_APP_PASSWORD>

# Redis (Optional / Cache & Background Tasks)
REDIS_URL=redis://<REDIS_HOST>:6379/0
